{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "^www\\.playgarba\\.com$"
        }
      ],
      "destination": "https://playgarba.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "^playgarba\\.com$"
        }
      ],
      "destination": "/public-site/"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "host",
          "value": "^playgarba\\.com$"
        }
      ],
      "destination": "/public-site/:path*"
    }
  ]
}
