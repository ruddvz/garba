{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/catalogue/",
      "has": [
        {
          "type": "host",
          "value": "live.playgarba.com"
        }
      ],
      "destination": "/src/catalogue/index.html"
    },
    {
      "source": "/catalogue/:path*",
      "has": [
        {
          "type": "host",
          "value": "live.playgarba.com"
        }
      ],
      "destination": "/src/catalogue/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "playgarba.com"
        }
      ],
      "destination": "/public-site/"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "playgarba.com"
        }
      ],
      "destination": "/public-site/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.playgarba.com"
        }
      ],
      "destination": "https://playgarba.com/:path*",
      "permanent": true
    }
  ]
}
