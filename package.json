{
  "name": "garba-music",
  "version": "0.6.7",
  "private": true,
  "description": "Open, community-built Gujarati Garba catalogue and immersive music player.",
  "scripts": {
    "catalogue": "node scripts/build-catalogue.mjs && node scripts/enrich-runtime-songs.mjs",
    "hosting:report": "node scripts/report-hosting-readiness.mjs",
    "rights:labels": "node scripts/report-label-acquisition.mjs",
    "rights:match": "node scripts/match-vendor-catalogue.mjs",
    "rights:match:test": "node scripts/test-catalogue-matcher.mjs",
    "rights:contacts:validate": "node scripts/validate-contact-map.mjs",
    "rights:outreach:validate": "node scripts/validate-outreach-queue.mjs",
    "rights:outreach:packet": "node scripts/generate-licensing-request.mjs",
    "rights:master:validate": "node scripts/validate-master-intake.mjs",
    "rights:master:plan": "node scripts/plan-direct-ingest.mjs",
    "rights:publish:validate": "node scripts/validate-publish-transaction.mjs",
    "audio:health": "node scripts/audit-direct-host-health.mjs",
    "repo:validate": "node scripts/validate-repository-structure.mjs",
    "docs:validate": "node scripts/validate-documentation.mjs",
    "serve": "python3 -m http.server 4173",
    "check:modules": "node --check simple-runtime.js && node --check provider-runtime.js && node --check nonstop-browser.js && node --input-type=module --check < app.js && node --check sw.js",
    "check": "npm run catalogue && npm run check:modules && node scripts/validate-runtime-song-routes.mjs && node scripts/validate-discovery.mjs"
  }
}
